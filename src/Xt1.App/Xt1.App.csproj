<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Xt1.App</AssemblyName>
    <RootNamespace>Xt1.App</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK.GLControl" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xt1.Core\Xt1.Core.csproj" />
  </ItemGroup>

  <!-- Convenience: ship the optional native dependencies when they exist on the build machine.
       Runtime resolution still goes through Settings / auto-detection; these copies only make
       a fresh build work out of the box on this machine. Missing files are simply skipped. -->
  <ItemGroup>
    <None Include="C:\bayonetta_tools\pkztools\oo2core_7_win64.dll"
          Condition="Exists('C:\bayonetta_tools\pkztools\oo2core_7_win64.dll')"
          Link="oo2core_7_win64.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
