<Window x:Class="Xt1.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:preview="clr-namespace:Xt1.App.Wpf.Preview"
        xmlns:inspector="clr-namespace:Xt1.App.Wpf.Inspector"
        Title="XT1 Studio" Height="800" Width="1320" MinHeight="620" MinWidth="1080"
        Icon="/Xt1Studio.ico"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource Brush.Window}">

    <Grid Background="{DynamicResource Brush.Window}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Menu bar -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="6,3">
                <Button Style="{StaticResource MenuTopButton}" Content="File" Click="OnOpenMenu">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open..." Click="OnMenuOpenFile" InputGestureText="Ctrl+O" />
                            <MenuItem Header="New empty bank..." Click="OnMenuNewBank" />
                            <MenuItem Header="Reload" Click="OnMenuReload" />
                            <Separator Style="{StaticResource MenuSeparator}" />
                            <MenuItem Header="Save" Click="OnMenuSave" InputGestureText="Ctrl+S" />
                            <MenuItem Header="Save As..." Click="OnMenuSaveAs" />
                            <Separator Style="{StaticResource MenuSeparator}" />
                            <MenuItem Header="Exit" Click="OnMenuExit" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Style="{StaticResource MenuTopButton}" Content="Edit" Click="OnOpenMenu">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="UndoMenuItem" Header="Undo" Click="OnMenuUndo" InputGestureText="Ctrl+Z" IsEnabled="False" />
                            <MenuItem x:Name="RedoMenuItem" Header="Redo" Click="OnMenuRedo" InputGestureText="Ctrl+Y" IsEnabled="False" />
                            <Separator Style="{StaticResource MenuSeparator}" />
                            <MenuItem Header="Export every texture in this container (PNG folder)..." Click="OnMenuExportContainer" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Style="{StaticResource MenuTopButton}" Content="Tools" Click="OnOpenMenu">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Settings..." Click="OnMenuSettings" />
                            <MenuItem Header="Batch recompress (ASTC to BC)..." Click="OnMenuBatchRecompress"
                                      ToolTip="Recompress the loaded document, or every bank in a folder, from ASTC to BC" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Style="{StaticResource MenuTopButton}" Content="Help" Click="OnOpenMenu">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="About" Click="OnMenuAbout" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1">
            <Grid Margin="10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Mip" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="2,0,7,0" />
                    <ComboBox x:Name="MipCombo" Style="{StaticResource PillComboBox}" Width="150"
                              ToolTip="Preview mip level" SelectionChanged="OnMipChanged" />

                    <TextBlock Text="Channel" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="16,0,7,0" />
                    <ComboBox x:Name="ChannelCombo" Style="{StaticResource PillComboBox}" Width="110"
                              ToolTip="Isolate a colour channel in the preview" SelectionChanged="OnChannelChanged" />

                    <CheckBox x:Name="OpaqueCheck" Style="{StaticResource PillCheckBox}" Content="Opaque Preview" Margin="16,0,0,0"
                              ToolTip="Ignore the alpha channel: 2D shows the RGB as-is, 3D derives the volume opacity from the RGB"
                              Click="OnOpaqueChanged" />

                    <Button x:Name="UndoButton" Style="{StaticResource PillButton}" Margin="16,0,0,0" IsEnabled="False"
                            Click="OnUndoClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE7A7;" />
                            <TextBlock Text="Undo" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RedoButton" Style="{StaticResource PillButton}" Margin="8,0,0,0" IsEnabled="False"
                            Click="OnRedoClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE7A6;" />
                            <TextBlock Text="Redo" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ResetViewButton" Style="{StaticResource PillButton}" Margin="8,0,0,0"
                            Click="OnResetView" ToolTip="Fit this preview to the viewport, and reset the 3D camera when one is active">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" />
                            <TextBlock Text="Reset View" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button x:Name="ThemeButton" Grid.Column="1" Style="{StaticResource PillButton}" Margin="8,0,0,0"
                        ToolTip="Toggle light / dark theme">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ThemeIcon" Style="{StaticResource IconText}" Text="&#xE708;" />
                        <TextBlock Text="Theme" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Main area -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" MinWidth="220" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="380" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Left: asset browser on top, resizable file browser below -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="110" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" MinHeight="110" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Asset Browser" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Heading}" Margin="14,12,14,6" />
                        <TreeView x:Name="DocumentTree" Margin="6,0,4,6" Background="Transparent" BorderThickness="0"
                                  SelectedItemChanged="OnTreeSelectionChanged"
                                  PreviewMouseRightButtonDown="OnTreePreviewMouseRightButtonDown">
                            <TreeView.ContextMenu>
                                <ContextMenu Opened="OnTreeMenuOpened">
                                    <MenuItem x:Name="TreeMenuReplace" Header="Replace..." Click="OnTreeReplace"
                                              ToolTip="Replace this texture from an image (re-encoded) or a DDS (lossless)" />
                                    <MenuItem x:Name="TreeMenuReplaceXt1" Header="Replace with .xt1..." Click="OnTreeReplaceXt1"
                                              ToolTip="Replace the header and payload from a raw .xt1, or drop in a bare payload" />
                                    <Separator Style="{StaticResource MenuSeparator}" />
                                    <MenuItem x:Name="TreeMenuExportGroup" Header="Export">
                                        <MenuItem x:Name="TreeMenuExportPng" Header="Export .png..." Click="OnTreeExportPng" />
                                        <MenuItem x:Name="TreeMenuExportDds" Header="Export .dds..." Click="OnTreeExportDds" />
                                        <MenuItem x:Name="TreeMenuExportXt1" Header="Export .xt1..." Click="OnTreeExportXt1" />
                                    </MenuItem>
                                    <Separator Style="{StaticResource MenuSeparator}" />
                                    <MenuItem x:Name="TreeMenuAddTexture" Header="Add texture from image..." Click="OnTreeAddTexture"
                                              ToolTip="Add a new texture to this bank from an image or a DDS" />
                                    <MenuItem x:Name="TreeMenuDelete" Header="Delete texture" Click="OnTreeDelete" />
                                    <Separator Style="{StaticResource MenuSeparator}" />
                                    <MenuItem x:Name="TreeMenuCopyHash" Header="Copy hash" Click="OnTreeCopyHash" />
                                    <Separator Style="{StaticResource MenuSeparator}" />
                                    <MenuItem x:Name="TreeMenuExportBank" Header="Export every texture in this bank (PNG folder)..."
                                              Click="OnTreeExportBank" />
                                </ContextMenu>
                            </TreeView.ContextMenu>
                        </TreeView>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent"
                              ResizeBehavior="PreviousAndNext" />

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="File Browser" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Heading}" Margin="14,12,14,6" />
                        <ListView x:Name="FileList" Margin="6,0,4,6" Background="Transparent" BorderThickness="0"
                                  SelectionChanged="OnFileSelectionChanged"
                                  PreviewMouseRightButtonDown="OnFilePreviewMouseRightButtonDown">
                            <ListView.ContextMenu>
                                <ContextMenu Opened="OnFileMenuOpened">
                                    <MenuItem x:Name="FileMenuOpen" Header="Open" Click="OnFileMenuOpen" />
                                    <MenuItem x:Name="FileMenuReload" Header="Reload" Click="OnFileMenuReload" />
                                    <Separator Style="{StaticResource MenuSeparator}" />
                                    <MenuItem x:Name="FileMenuCopyPath" Header="Copy full path" Click="OnFileMenuCopyPath" />
                                    <MenuItem x:Name="FileMenuReveal" Header="Show in Explorer" Click="OnFileMenuReveal" />
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                    <Setter Property="FontWeight" Value="{Binding Weight}" />
                                    <Setter Property="ToolTip" Value="{Binding Path}" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView AllowsColumnReorder="False">
                                    <GridViewColumn x:Name="FileColumnName" Header="Name" Width="112" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn x:Name="FileColumnModified" Header="Modified" Width="96" DisplayMemberBinding="{Binding Modified}" />
                                    <GridViewColumn x:Name="FileColumnSize" Header="Size" Width="62" DisplayMemberBinding="{Binding Size}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" />

            <!-- Center: 2D / Cube-3D viewport -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Background="{DynamicResource Brush.Viewer}"
                    ClipToBounds="True">
                <TabControl x:Name="ViewTabs" Style="{StaticResource UnderlineTabControl}" Background="Transparent" Margin="6">
                    <TabItem Style="{StaticResource UnderlineTabItem}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconTextSmall}" Text="&#xE91B;" />
                                <TextBlock Text="2D" Margin="7,0,0,0" />
                            </StackPanel>
                        </TabItem.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <preview:Image2DView x:Name="Preview2D"
                                                     ToolTip="Drag to pan, wheel to zoom, double-click to fit" />
                                <StackPanel x:Name="PreviewEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                    <TextBlock Style="{StaticResource IconText}" FontSize="44" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Brush.BorderStrong}" Text="&#xE91B;" />
                                    <TextBlock Text="No preview" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Margin="0,14,0,0" Foreground="{DynamicResource Brush.Muted}" />
                                    <TextBlock Text="Open a texture or select an item from the asset browser."
                                               HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{DynamicResource Brush.Muted}" />
                                </StackPanel>
                            </Grid>

                            <!-- Layer animation: a 3D/multilayer texture whose depth is really a sequence
                                 of animation frames can be played here. Shown only for such textures; a
                                 regular 2D texture or a cubemap never sees it. -->
                            <Border x:Name="AnimBar" Grid.Row="1" Visibility="Collapsed"
                                    Background="{DynamicResource Brush.Card}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                                <Grid Margin="12,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="AnimPlayButton" Grid.Column="0" Style="{StaticResource PillButton}"
                                            Click="OnAnimPlayToggle" ToolTip="Play or pause the layer animation">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="AnimPlayIcon" Style="{StaticResource IconText}" Text="&#xE768;" />
                                            <TextBlock x:Name="AnimPlayText" Text="Play" Margin="7,0,0,0" />
                                        </StackPanel>
                                    </Button>

                                    <TextBlock Grid.Column="1" Text="FPS" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Muted}" Margin="16,0,7,0" />
                                    <TextBox x:Name="FpsBox" Grid.Column="2" Style="{StaticResource FieldBox}"
                                             Width="46" Text="15" FontFamily="Consolas" VerticalContentAlignment="Center"
                                             ToolTip="Playback speed in frames per second (1 - 240)"
                                             LostFocus="OnFpsChanged" KeyDown="OnFpsKeyDown" />

                                    <Slider x:Name="AnimSlider" Grid.Column="3" Style="{StaticResource TimeBarSlider}"
                                            Margin="16,0,0,0" MinWidth="80" SmallChange="1" LargeChange="1"
                                            ToolTip="Scrub through the texture's layers / animation frames"
                                            ValueChanged="OnAnimSliderValueChanged" />

                                    <TextBlock x:Name="AnimFrameText" Grid.Column="4" VerticalAlignment="Center"
                                               Margin="12,0,0,0" Foreground="{DynamicResource Brush.Muted}"
                                               Text="0 / 0" />
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Style="{StaticResource UnderlineTabItem}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconTextSmall}" Text="&#xE809;" />
                                <TextBlock Text="Cube-3D" Margin="7,0,0,0" />
                            </StackPanel>
                        </TabItem.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- The shared WinForms OpenGL viewport, hosted in the WPF tree. It is
                                 collapsed whenever the placeholder below must be readable, because a
                                 WindowsFormsHost child renders above WPF content (airspace). -->
                            <preview:GlVolumeView x:Name="GlView" Grid.Row="0" Visibility="Collapsed" />

                            <StackPanel x:Name="Preview3DEmpty" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <TextBlock Style="{StaticResource IconText}" FontSize="44" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Brush.BorderStrong}" Text="&#xE809;" />
                                <TextBlock x:Name="Preview3DTitle" Text="No preview" FontSize="18" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,14,0,0" Foreground="{DynamicResource Brush.Muted}" />
                                <TextBlock x:Name="Preview3DNote" Text="Select a cube or volume texture to orbit it here."
                                           HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{DynamicResource Brush.Muted}" />
                            </StackPanel>

                            <!-- Preview controls, split by what they actually drive: the slice/render
                                 group belongs to the ray-marched volume, while gamma/exposure feed the
                                 sky (cubemap/HDR) shader and mean nothing for a volume. -->
                            <Border x:Name="VolumeBar" Grid.Row="1" Visibility="Collapsed"
                                    Background="{DynamicResource Brush.Card}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                                <StackPanel Margin="12,6">
                                    <StackPanel x:Name="VolumeOnlyGroup" Orientation="Horizontal">
                                        <TextBlock Text="Slice" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Muted}" Margin="0,0,7,0" />
                                        <ComboBox x:Name="SliceCombo" Style="{StaticResource PillComboBox}"
                                                  Width="104"
                                                  ToolTip="Volume slice shown in the 2D tab and as the cross-section plane"
                                                  SelectionChanged="OnSliceChanged" />
                                        <TextBlock Text="Render" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Muted}" Margin="16,0,7,0" />
                                        <ComboBox x:Name="VolumeModeCombo" Style="{StaticResource PillComboBox}"
                                                  Width="78"
                                                  ToolTip="Volume render mode: RGB luminance, stored alpha, or maximum-intensity projection"
                                                  SelectionChanged="OnVolumeModeChanged" />
                                        <CheckBox x:Name="ShowSlicesCheck" Style="{StaticResource PillCheckBox}"
                                                  Content="Slice planes" Margin="12,0,0,0"
                                                  ToolTip="Overlay the X/Y/Z cross-section planes"
                                                  Click="OnShowSlicesChanged" />
                                    </StackPanel>

                                    <StackPanel x:Name="SkyOnlyGroup" Orientation="Horizontal">
                                        <TextBlock Text="Gamma" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Muted}" Margin="0,0,7,0" />
                                        <TextBox x:Name="GammaBox" Style="{StaticResource FieldBox}"
                                                 Width="58" FontFamily="Consolas" VerticalContentAlignment="Center"
                                                 ToolTip="Display gamma for the sky render (0.10 - 8.00); 1.00 leaves values unchanged"
                                                 LostFocus="OnGammaExposureChanged" KeyDown="OnGammaExposureKeyDown" />
                                        <TextBlock Text="Exposure" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Muted}" Margin="14,0,7,0" />
                                        <TextBox x:Name="ExposureBox" Style="{StaticResource FieldBox}"
                                                 Width="58" FontFamily="Consolas" VerticalContentAlignment="Center"
                                                 ToolTip="Exposure multiplier applied before gamma (0.05 - 20.00); acts on the unclamped HDR sky values"
                                                 LostFocus="OnGammaExposureChanged" KeyDown="OnGammaExposureKeyDown" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" />

            <!-- Right: inspector -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="InspectorRoot">
                    <StackPanel Orientation="Horizontal" Margin="2,2,2,0">
                        <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource Brush.Control}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" VerticalAlignment="Top">
                            <TextBlock x:Name="TitleIcon" Style="{StaticResource IconText}" FontSize="20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Text="&#xE91B;" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" Text="No texture selected" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Heading}" />
                            <TextBlock x:Name="SubtitleText" Text="Open a bank and pick a texture from the tree."
                                       Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="SpecText" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap"
                               Margin="2,10,2,0" />

                    <Border x:Name="ValidationBanner" CornerRadius="10" Padding="12,9" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ValidationIcon" Style="{StaticResource IconTextSmall}" Text="&#xE73E;"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="ValidationText" Margin="9,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.SuccessText}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <ToggleButton x:Name="HashToggle" Style="{StaticResource CardHeaderToggle}" IsChecked="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="#" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
                                    <TextBlock Text="Hash" FontWeight="SemiBold" Margin="9,0,0,0" />
                                </StackPanel>
                            </ToggleButton>
                            <Grid Margin="14,0,14,14" Visibility="{Binding IsChecked, ElementName=HashToggle, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="CRC32 Hash" Foreground="{DynamicResource Brush.Muted}"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox x:Name="HashBox" Grid.Column="1" Style="{StaticResource FieldBox}"
                                         FontFamily="Consolas" VerticalContentAlignment="Center"
                                         LostFocus="OnHashBoxLostFocus" KeyDown="OnHashBoxKeyDown" />
                                <Button x:Name="HashCalcButton" Grid.Column="2" Style="{StaticResource PillButton}" Margin="8,0,0,0"
                                        Click="OnCalculateHash" ToolTipService.ShowOnDisabled="True">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconTextSmall}" Text="&#xE72C;" />
                                        <TextBlock Text="Calculate CRC32" Margin="7,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <ToggleButton x:Name="FlagsToggle" Style="{StaticResource CardHeaderToggle}" IsChecked="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconTextSmall}" Text="&#xE7C1;" />
                                    <TextBlock Text="Flags" FontWeight="SemiBold" Margin="9,0,0,0" />
                                </StackPanel>
                            </ToggleButton>
                            <StackPanel Margin="14,0,14,14" Visibility="{Binding IsChecked, ElementName=FlagsToggle, Converter={StaticResource BoolToVisibility}}">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Bank class" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
                                    <CheckBox x:Name="ModelCheck" Grid.Column="1" Style="{StaticResource PillCheckBox}"
                                              Content="Model / UI bank entry" HorizontalAlignment="Left" Click="OnModelFlagChanged"
                                              ToolTipService.ShowOnDisabled="True" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Color" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
                                    <CheckBox x:Name="SrgbCheck" Grid.Column="1" Style="{StaticResource PillCheckBox}"
                                              Content="sRGB color space" HorizontalAlignment="Left" Click="OnSrgbFlagChanged"
                                              ToolTipService.ShowOnDisabled="True" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Usage" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
                                    <CheckBox x:Name="CubeCheck" Grid.Column="1" Style="{StaticResource PillCheckBox}"
                                              Content="Cube map usage" HorizontalAlignment="Left" Click="OnCubeFlagChanged"
                                              ToolTipService.ShowOnDisabled="True" />
                                </Grid>
                                <TextBlock x:Name="Table2Text" FontFamily="Consolas" Foreground="{DynamicResource Brush.Muted}"
                                           Margin="0,6,0,0" Text="table2 = -- -- -- --" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <ToggleButton x:Name="AdvancedToggle" Style="{StaticResource CardHeaderToggle}" IsChecked="False">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconTextSmall}" Text="&#xE713;" />
                                    <TextBlock Text="Advanced" FontWeight="SemiBold" Margin="9,0,0,0" />
                                </StackPanel>
                            </ToggleButton>
                            <StackPanel Margin="14,0,14,14"
                                        Visibility="{Binding IsChecked, ElementName=AdvancedToggle, Converter={StaticResource BoolToVisibility}}">
                                <Button x:Name="RawBytesButton" Style="{StaticResource PillButton}"
                                        HorizontalAlignment="Left" Click="OnRawBytes"
                                        ToolTipService.ShowOnDisabled="True"
                                        ToolTip="Open the XT1 header in the byte-level editor; unknown bytes survive a round trip">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconTextSmall}" Text="&#xE943;" />
                                        <TextBlock Text="View raw header bytes..." Margin="7,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="SummaryText" FontFamily="Consolas" TextWrapping="Wrap"
                                           Margin="0,10,0,10" Foreground="{DynamicResource Brush.Muted}"
                                           Text="(no technical summary)" />
                                <inspector:FieldEditorPanel x:Name="FieldEditor" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{DynamicResource Brush.Status}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0">
            <Grid Margin="12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusLeft" Grid.Column="0" Text="Ready" Foreground="{DynamicResource Brush.Muted}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="StatusZoom" Grid.Column="1" Margin="14,0,0,0" Foreground="{DynamicResource Brush.Muted}"
                           ToolTip="Preview zoom" />
                <TextBlock x:Name="StatusRight" Grid.Column="2" Margin="14,0,0,0" Foreground="{DynamicResource Brush.Muted}" />
            </Grid>
        </Border>
    </Grid>
</Window>



