<UserControl x:Class="Xt1.App.Wpf.Inspector.FieldEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <StackPanel>
        <TextBlock x:Name="HintText" Foreground="{DynamicResource Brush.Muted}" FontSize="11.5"
                   TextWrapping="Wrap" Margin="0,0,0,6"
                   Text="Select a texture to edit its fields." />
        <StackPanel x:Name="RowsHost" />
    </StackPanel>
</UserControl>
