<UserControl x:Class="Xt1.App.Wpf.Preview.GlVolumeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             Background="Transparent"
             ClipToBounds="True">
    <!-- The WinForms OpenGL control is a child window, so it never composites with WPF content.
         The host therefore only ever holds the GL control, and the shell collapses this whole
         view when it needs the empty-state placeholder to be visible. -->
    <Grid Background="Transparent" ClipToBounds="True">
        <!-- The WindowsFormsHost container sits behind the GL child. The child is rounded with a window
             region (see ApplyRoundedRegion), so its corners expose that container; without a themed
             background here those corners stay the default SystemColors.Control (white) in every theme. -->
        <wfi:WindowsFormsHost x:Name="Host" Background="{DynamicResource Brush.Viewer}" />
    </Grid>
</UserControl>

