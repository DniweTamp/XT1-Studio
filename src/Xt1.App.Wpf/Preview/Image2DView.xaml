<UserControl x:Class="Xt1.App.Wpf.Preview.Image2DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             ClipToBounds="True">
    <!-- The host supplies the viewer background; this control only draws the optional checkerboard and the image. -->
    <Grid Background="Transparent" ClipToBounds="True">
        <Rectangle x:Name="Checker" Fill="{DynamicResource Brush.Checkerboard}" Visibility="Collapsed" />
        <!-- The image element is sized to what is actually drawn (natural size * zoom) and panned by
             its margin. Deliberately no RenderTransform: an oversized layout rect (mip 0 is 1024x1024)
             left the element larger than the viewport, so the ancestor ClipToBounds clipped it in
             untransformed space and only the top-left fraction of the texture survived. -->
        <Image x:Name="Surface" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top"
               IsHitTestVisible="False" />
    </Grid>
</UserControl>
