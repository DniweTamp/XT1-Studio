<dialogs:ThemedDialog x:Class="Xt1.App.Wpf.Dialogs.SettingsDialog"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:dialogs="clr-namespace:Xt1.App.Wpf.Dialogs"
                      Title="Settings" Width="640" Height="600" ResizeMode="NoResize"
                      Background="{DynamicResource Brush.Window}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="18,16,18,6">
            <StackPanel>

                <TextBlock Style="{StaticResource SectionHeader}" Text="Encoder" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="EncoderText" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                               VerticalAlignment="Center" Margin="0,0,0,6"
                               Foreground="{DynamicResource Brush.Text}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource DialogHint}"
                               x:Name="EncoderHint" TextWrapping="Wrap" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DialogLabel}"
                               Text="Default import format" Margin="0,0,12,6" />
                    <ComboBox x:Name="FormatCombo" Grid.Row="2" Grid.Column="1" Style="{StaticResource PillComboBox}"
                              HorizontalAlignment="Stretch" Margin="0,0,0,6" />

                    <CheckBox x:Name="SyncCheck" Grid.Row="3" Grid.Column="1" Style="{StaticResource PillCheckBox}"
                              HorizontalAlignment="Left"
                              Content="Sync WTB sRGB / cubemap flags from the format"
                              ToolTip="On add or replace, copy the sRGB and cubemap flags from the chosen texture format into the WTB flags." />
                </Grid>

                <TextBlock Style="{StaticResource SectionHeader}" Text="Native tools" Margin="0,18,0,0" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DialogLabel}"
                               Text="nvtt30205.dll" Margin="0,0,12,6" />
                    <TextBox x:Name="NvttDllBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Margin="0,0,8,6" TextChanged="OnNvttDllChanged"
                             ToolTip="Optional. Point at NVIDIA Texture Tools' nvtt30205.dll to use NVTT for encoding; leave blank to auto-detect it." />
                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource PillButton}"
                            Content="Browse..." Margin="0,0,0,6" Click="OnBrowseNvtt" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource DialogHint}"
                               TextWrapping="Wrap"
                               Text="Optional: NVTT gives faster, higher-quality encodes and is the only way to encode BC6H; without it the built-in encoder is used. Leave blank to look in the app folder, then the NVIDIA Texture Tools install directory, then PATH." />
                </Grid>

                <TextBlock Style="{StaticResource SectionHeader}" Text="Preview" Margin="0,18,0,0" />

                <CheckBox x:Name="OpaqueAlphaCheck" Style="{StaticResource PillCheckBox}"
                          Content="Start with opaque alpha (ignore stored alpha)" HorizontalAlignment="Left"
                          Margin="170,8,0,4" />
                <CheckBox x:Name="ShowAlphaCheck" Style="{StaticResource PillCheckBox}"
                          Content="Offer the alpha-only option in the channel selector" HorizontalAlignment="Left"
                          Margin="170,0,0,8" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource DialogLabel}" Text="Volume preview cap"
                               Margin="0,0,12,0" />
                    <TextBox x:Name="VolumeCapBox" Grid.Column="1" Style="{StaticResource FieldBox}" Width="90"
                             HorizontalAlignment="Left" TextChanged="OnVolumeCapChanged" />
                </Grid>
                <TextBlock x:Name="VolumeCapHint" Style="{StaticResource DialogHint}" Margin="0,5,0,0"
                           Text="Larger 3D volumes are downscaled for the GPU preview only." />

                <TextBlock Style="{StaticResource SectionHeader}" Text="Explorer" Margin="0,18,0,0" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DialogLabel}"
                               Text="Thumbnails for .xt1" Margin="0,0,12,6" />
                    <Button x:Name="ShellButton" Grid.Row="0" Grid.Column="1" Style="{StaticResource PillButton}"
                            Content="Register" HorizontalAlignment="Left" MinWidth="110" Click="OnToggleShell" />

                    <CheckBox x:Name="ShellMachineCheck" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                              Style="{StaticResource PillCheckBox}" Margin="0,0,0,4" HorizontalAlignment="Left"
                              Content="For all users on this machine (needs an administrator)" />

                    <TextBlock x:Name="ShellStatus" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                               Style="{StaticResource DialogHint}" TextWrapping="Wrap" />
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="18,10">
            <StackPanel Style="{StaticResource DialogButtonRow}">
                <Button Style="{StaticResource PillButton}" Content="OK" IsDefault="True" MinWidth="84"
                        Click="OnOk" />
                <Button Style="{StaticResource PillButton}" Content="Cancel" IsCancel="True" MinWidth="84"
                        Margin="8,0,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</dialogs:ThemedDialog>

