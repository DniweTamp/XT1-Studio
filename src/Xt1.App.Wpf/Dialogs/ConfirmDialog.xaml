<dialogs:ThemedDialog x:Class="Xt1.App.Wpf.Dialogs.ConfirmDialog"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:dialogs="clr-namespace:Xt1.App.Wpf.Dialogs"
                      Title="Confirm" Width="460" SizeToContent="Height" MaxHeight="520" ResizeMode="NoResize"
                      Background="{DynamicResource Brush.Window}">
    <Grid Margin="18,16,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" MaxHeight="320" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" />
        </ScrollViewer>

        <StackPanel Grid.Row="1" Style="{StaticResource DialogButtonRow}" Margin="0,16,0,0">
            <Button x:Name="ConfirmButton" Style="{StaticResource PillButton}" Content="Continue" MinWidth="96"
                    Click="OnConfirm" />
            <Button Style="{StaticResource PillButton}" Content="Cancel" MinWidth="96" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</dialogs:ThemedDialog>
