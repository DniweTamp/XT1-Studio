<dialogs:ThemedDialog x:Class="Xt1.App.Wpf.Dialogs.AboutDialog"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:dialogs="clr-namespace:Xt1.App.Wpf.Dialogs"
                      Title="About" Width="460" Height="300" ResizeMode="NoResize"
                      Background="{DynamicResource Brush.Window}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,20,24,0">
            <TextBlock Style="{StaticResource DialogTitle}" Text="XT1 Studio" />
            <TextBlock x:Name="VersionText" Style="{StaticResource DialogHint}" Margin="0,4,0,0" />
            <TextBlock Text="Viewer/editor for PlatinumGames WTB/XT1 texture banks." TextWrapping="Wrap"
                       Margin="0,18,0,0" />
            <TextBlock Text="Format reference: XT1_FORMAT.md" TextWrapping="Wrap" Margin="0,14,0,0" />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="18,10">
            <StackPanel Style="{StaticResource DialogButtonRow}">
                <Button Style="{StaticResource PillButton}" Content="Close" IsDefault="True" IsCancel="True"
                        MinWidth="84" />
            </StackPanel>
        </Border>
    </Grid>
</dialogs:ThemedDialog>
