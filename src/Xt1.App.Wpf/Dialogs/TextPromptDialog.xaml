<dialogs:ThemedDialog x:Class="Xt1.App.Wpf.Dialogs.TextPromptDialog"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:dialogs="clr-namespace:Xt1.App.Wpf.Dialogs"
                      Width="380" Height="180" ResizeMode="NoResize"
                      Background="{DynamicResource Brush.Window}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="18,18,18,0">
            <TextBlock x:Name="PromptText" TextWrapping="Wrap" />
            <TextBox x:Name="InputBox" Style="{StaticResource FieldBox}" Margin="0,10,0,0" />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="18,10">
            <StackPanel Style="{StaticResource DialogButtonRow}">
                <Button Style="{StaticResource PillButton}" Content="OK" IsDefault="True" MinWidth="84"
                        Click="OnOk" />
                <Button Style="{StaticResource PillButton}" Content="Cancel" IsCancel="True" MinWidth="84"
                        Margin="8,0,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</dialogs:ThemedDialog>
