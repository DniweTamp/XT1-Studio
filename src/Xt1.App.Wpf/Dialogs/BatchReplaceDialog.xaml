<dialogs:ThemedDialog x:Class="Xt1.App.Wpf.Dialogs.BatchReplaceDialog"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:dialogs="clr-namespace:Xt1.App.Wpf.Dialogs"
                      Title="Batch replace textures" Width="960" Height="680" MinWidth="820" MinHeight="560"
                      Background="{DynamicResource Brush.Window}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="18,16,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel Margin="14,12,14,14">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Source" Margin="0,0,0,12" />

                    <TextBlock x:Name="BankText" Foreground="{DynamicResource Brush.Text}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />

                    <TextBlock Text="Folder of replacement files" Foreground="{DynamicResource Brush.Muted}"
                               Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderBox" Grid.Column="0" Style="{StaticResource FieldBox}" IsReadOnly="True" />
                        <Button x:Name="FolderBrowse" Grid.Column="1" Style="{StaticResource PillButton}"
                                Margin="8,0,0,0" Click="OnBrowse" ToolTip="Browse for a folder">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE838;" />
                        </Button>
                    </Grid>

                    <TextBlock Style="{StaticResource DialogHint}"
                               Text="One folder, top level only. Files are matched by tex&lt;index&gt;_0x&lt;hash&gt; (e.g. tex12_0xAB12CD34.png); a raw .xt1 wins over a .dds, which wins over an image." />
                </StackPanel>
            </Border>

            <Border x:Name="OptionsCard" Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel Margin="14,12,14,14">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Options" Margin="0,0,0,12" />

                    <TextBlock Text="Texture compression quality" Foreground="{DynamicResource Brush.Muted}"
                               Margin="0,0,0,4" />
                    <ComboBox x:Name="QualityCombo" Style="{StaticResource PillComboBox}"
                              HorizontalAlignment="Stretch" Margin="0,0,0,12" />

                    <CheckBox x:Name="SolidifyCheck" Style="{StaticResource PillCheckBox}" HorizontalAlignment="Left"
                              Content="Solidify (edge-pad transparent RGB)" Margin="0,0,0,10"
                              ToolTip="Fill fully transparent pixels from their nearest opaque neighbours before encoding, to avoid dark fringes." />

                    <TextBlock x:Name="OptionHint" Style="{StaticResource DialogHint}"
                               Text="Applied to every re-encoded texture. Each texture keeps its existing format." />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="18,12,18,0">
            <Grid Margin="14,12,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}" Text="Scan / Log" Margin="0,0,0,10" />
                <TextBox x:Name="LogBox" Grid.Row="1" Style="{StaticResource FieldBox}" IsReadOnly="True"
                         AcceptsReturn="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         ToolTip="Which files match which textures, and the result of each replacement" />
            </Grid>
        </Border>

        <!-- Themed busy sweep: a clipped accent block, so no stock progress chrome appears in dark mode. -->
        <Border x:Name="BusyBar" Grid.Row="2" Height="3" Margin="18,10,18,0" ClipToBounds="True"
                Background="{DynamicResource Brush.Input}" Visibility="Collapsed">
            <Rectangle x:Name="BusyBlock" Width="140" HorizontalAlignment="Left"
                       Fill="{DynamicResource Brush.Accent}">
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="BusyShift" X="-140" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Border>

        <Grid Grid.Row="3" Margin="18,8,18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="RunStatus" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.Muted}" TextTrimming="CharacterEllipsis" />
            <Button x:Name="RunButton" Grid.Column="1" Style="{StaticResource PillButton}" Content="Replace"
                    MinWidth="96" IsEnabled="False" Click="OnRun" />
            <Button Grid.Column="2" Style="{StaticResource PillButton}" Content="Close" MinWidth="96" Margin="8,0,0,0"
                    IsCancel="True" Click="OnClose" />
        </Grid>
    </Grid>
</dialogs:ThemedDialog>
