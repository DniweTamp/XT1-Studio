<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The WinForms renderer, compiled as a library so the WPF shell can host the same OpenGL preview
    through WindowsFormsHost. The sources live here (they used to be linked out of the WinForms app,
    which the WPF shell replaces): the GL control, its palette/theme manager and the WinForms 2D
    viewer that declares ImageChannelMode.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Xt1.Rendering.WinForms</AssemblyName>
    <RootNamespace>Xt1.Rendering.WinForms</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK.GLControl" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xt1.Core\Xt1.Core.csproj" />
  </ItemGroup>

</Project>
